{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tbom.yozi.systems/schemas/edge-network-topology/4.0.0/observation-projection.schema.json",
  "title": "Edge Network Topology Profile 4 Observation Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection_consistency", "conformance", "datasets", "disclosure_profile_id", "interfaces", "neighbors", "projection_id", "routes", "structural_topology_fingerprint"],
  "properties": {
    "collection_consistency": {"enum": ["generation_validated_sequential", "sequential_non_atomic", "single_dataset_atomic", "unknown"]},
    "conformance": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://tbom.yozi.systems/schemas/edge-network-topology/4.0.0/conformance.schema.json"}},
    "datasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/dataset"}},
    "disclosure_profile_id": {"type": "string", "pattern": "^https://tbom\\.yozi\\.systems/registries/edge-network/disclosure-profiles/1/"},
    "interfaces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/interface"}},
    "neighbors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/neighbor"}},
    "projection_id": {"const": "https://tbom.yozi.systems/projections/edge-network-topology/4.0.0/observation"},
    "routes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/route"}},
    "structural_topology_fingerprint": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"disclosure_profile_id": {"const": "https://tbom.yozi.systems/registries/edge-network/disclosure-profiles/1/public-minimal"}}},
      "then": {"properties": {"interfaces": {"items": {"allOf": [
        {"not": {"required": ["interface_kind_observed"]}},
        {"not": {"required": ["kind_state"]}}
      ]}}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reason": {"type": "string", "pattern": "^https://tbom\\.yozi\\.systems/registries/edge-network/reason-codes/1/"},
    "uri": {"type": "string", "format": "uri", "pattern": "^https://tbom\\.yozi\\.systems/"},
    "encodedValue": {
      "description": "The encoding is utf-8 if and only if the original bytes are valid UTF-8; otherwise it is canonical unpadded base64url.",
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["encoding", "value"], "properties": {"encoding": {"const": "utf-8"}, "value": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["encoding", "value"], "properties": {"encoding": {"const": "base64url"}, "value": {"type": "string", "minLength": 2, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"}}}
      ]
    },
    "binaryValue": {
      "description": "A semantically binary network-protocol value encoded as canonical unpadded base64url. UTF-8 preference does not apply.",
      "type": "object", "additionalProperties": false, "required": ["encoding", "value"],
      "properties": {"encoding": {"const": "base64url"}, "value": {"type": "string", "minLength": 2, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"}}
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "dataset", "namespace_key", "reason_codes", "records_emitted", "records_seen", "status"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "dataset": {"enum": ["links", "addresses", "neighbors", "routes", "tunnels", "conformance"]},
        "namespace_key": {"type": "string", "minLength": 1},
        "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/reason"}, "uniqueItems": true},
        "records_emitted": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "records_seen": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "status": {"enum": ["complete", "partial", "failed", "not-requested", "unsupported"]}
      }
    },
    "address": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "family", "flags", "peer_address", "prefix_length", "scope"],
      "properties": {
        "address": {"$ref": "#/$defs/binaryValue"}, "family": {"enum": [4, 6]},
        "flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "peer_address": {"anyOf": [{"$ref": "#/$defs/binaryValue"}, {"type": "null"}]},
        "prefix_length": {"type": "integer", "minimum": 0, "maximum": 128}, "scope": {"type": "string", "minLength": 1}
      }
    },
    "linkAddress": {
      "type": "object", "additionalProperties": false, "required": ["address", "address_type"],
      "properties": {"address": {"$ref": "#/$defs/binaryValue"}, "address_type": {"type": "string", "minLength": 1}}
    },
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["address", "family", "port", "transport"], "properties": {"address": {"$ref": "#/$defs/binaryValue"}, "family": {"enum": [4, 6]}, "port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535}, "transport": {"type": ["string", "null"], "enum": ["tcp", "udp", null]}}},
    "bridgeState": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "stp_state", "vlan_filtering"],
      "properties": {
        "kind": {"const": "bridge"},
        "stp_state": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "vlan_filtering": {"type": ["boolean", "null"]}
      }
    },
    "vlanState": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "vlan_id", "vlan_protocol"],
      "properties": {
        "kind": {"const": "vlan"},
        "vlan_id": {"type": "integer", "minimum": 0, "maximum": 4094},
        "vlan_protocol": {"enum": [33024, 34984]}
      }
    },
    "tunnelState": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "local_endpoint", "remote_endpoint"],
      "properties": {
        "kind": {"const": "tunnel"},
        "local_endpoint": {"anyOf": [{"$ref": "#/$defs/endpoint"}, {"type": "null"}]},
        "remote_endpoint": {"anyOf": [{"$ref": "#/$defs/endpoint"}, {"type": "null"}]}
      }
    },
    "logicalState": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "logical_kind", "vrf_table"],
      "properties": {
        "kind": {"const": "logical"},
        "logical_kind": {"type": "string", "pattern": "^https://tbom\\.yozi\\.systems/registries/edge-network/interface-kinds/1/"},
        "vrf_table": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295}
      }
    },
    "kindState": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/bridgeState"},
        {"$ref": "#/$defs/vlanState"},
        {"$ref": "#/$defs/tunnelState"},
        {"$ref": "#/$defs/logicalState"}
      ]
    },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace_key", "observation_subject_id"],
      "properties": {
        "addresses": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/address"}},
        "carrier": {"type": ["boolean", "null"]}, "current_link_address": {"anyOf": [{"$ref": "#/$defs/linkAddress"}, {"type": "null"}]},
        "declared_semantic_id": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "interface_kind_observed": {"type": ["string", "null"]}, "interface_name_observed": {"$ref": "#/$defs/encodedValue"},
        "kind_state": {"$ref": "#/$defs/kindState"},
        "link_status": {"enum": ["up", "down", "dormant", "testing", "unknown"]},
        "master_observed": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "mtu": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}, "namespace_key": {"type": "string", "minLength": 1},
        "observation_subject_id": {"$ref": "#/$defs/digest"}, "parent_observed": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "permanent_link_address": {"anyOf": [{"$ref": "#/$defs/linkAddress"}, {"type": "null"}]}
      }
    },
    "neighbor": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "family", "interface_semantic_id", "interface_subject_id", "link_address", "namespace_key", "observation_subject_id", "state"],
      "properties": {
        "address": {"$ref": "#/$defs/binaryValue"}, "family": {"enum": [4, 6]},
        "interface_semantic_id": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "interface_subject_id": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "link_address": {"anyOf": [{"$ref": "#/$defs/linkAddress"}, {"type": "null"}]}, "namespace_key": {"type": "string", "minLength": 1},
        "observation_subject_id": {"$ref": "#/$defs/digest"}, "state": {"type": "string", "minLength": 1}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["destination", "family", "gateway", "metric", "output_interface_semantic_id", "output_interface_subject_id", "prefix_length", "protocol", "route_type", "scope", "table"],
      "properties": {
        "destination": {"$ref": "#/$defs/binaryValue"}, "family": {"enum": [4, 6]},
        "gateway": {"anyOf": [{"$ref": "#/$defs/binaryValue"}, {"type": "null"}]}, "metric": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "output_interface_semantic_id": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "output_interface_subject_id": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "prefix_length": {"type": "integer", "minimum": 0, "maximum": 128}, "protocol": {"type": "string", "minLength": 1},
        "route_type": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "table": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    }
  }
}
