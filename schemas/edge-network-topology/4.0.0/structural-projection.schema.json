{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tbom.yozi.systems/schemas/edge-network-topology/4.0.0/structural-projection.schema.json",
  "title": "Edge Network Topology Profile 4 Structural Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "projection_id", "relations"],
  "properties": {
    "nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/node"}},
    "projection_id": {"const": "https://tbom.yozi.systems/projections/edge-network-topology/4.0.0/structural"},
    "relations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uri": {"type": "string", "format": "uri", "pattern": "^https://tbom\\.yozi\\.systems/"},
    "foreignHttpsUri": {"type": "string", "format": "uri", "pattern": "^https://"},
    "encodedValue": {
      "description": "The encoding is utf-8 if and only if the original bytes are valid UTF-8; otherwise it is canonical unpadded base64url.",
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["encoding", "value"], "properties": {"encoding": {"const": "utf-8"}, "value": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["encoding", "value"], "properties": {"encoding": {"const": "base64url"}, "value": {"type": "string", "minLength": 2, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"}}}
      ]
    },
    "parameter": {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"$ref": "#/$defs/uri"}, "value": {"type": ["string", "integer", "boolean", "null"], "minimum": 0, "maximum": 9007199254740991}}},
    "tunnelParameter": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/tunnel-parameters/1/vxlan-vni"}, "value": {"type": "integer", "minimum": 0, "maximum": 16777215}}},
        {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/tunnel-parameters/1/gre-key-id"}, "value": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
        {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/tunnel-parameters/1/wireguard-public-key-id"}, "value": {"$ref": "#/$defs/digest"}}},
        {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/tunnel-parameters/1/udp-destination-port"}, "value": {"type": "integer", "minimum": 0, "maximum": 65535}}},
        {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/tunnel-parameters/1/hop-limit"}, "value": {"type": "integer", "minimum": 0, "maximum": 255}}}
      ]
    },
    "bridgeParameter": {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/bridge-parameters/1/stp-enabled"}, "value": {"type": "boolean"}}},
    "logicalParameter": {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/logical-parameters/1/vrf-table"}, "value": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
    "federationParameter": {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/federation-governance-parameters/1/require-mutual-authentication"}, "value": {"type": "boolean"}}},
    "relationParameter": {"type": "object", "additionalProperties": false, "required": ["parameter_id", "value"], "properties": {"parameter_id": {"const": "https://tbom.yozi.systems/registries/edge-network/relation-parameters/1/required"}, "value": {"type": "boolean"}}},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["address", "family", "port", "transport"], "properties": {"address": {"$ref": "#/$defs/encodedValue"}, "family": {"enum": [4, 6]}, "port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535}, "transport": {"type": ["string", "null"], "enum": ["tcp", "udp", null]}}},
    "common": {
      "type": "object",
      "required": ["interface_kind", "interface_name", "namespace_key", "node_type", "semantic_id", "semantic_id_algorithm"],
      "properties": {
        "interface_kind": {"$ref": "#/$defs/uri"}, "interface_name": {"anyOf": [{"$ref": "#/$defs/encodedValue"}, {"type": "null"}]},
        "namespace_key": {"type": "string", "minLength": 1}, "node_type": {"$ref": "#/$defs/uri"},
        "semantic_id": {"$ref": "#/$defs/digest"},
        "semantic_id_algorithm": {"const": "https://tbom.yozi.systems/algorithms/edge-network-topology/4.0.0/semantic-id-yozi-tid-v1-sha256"}
      }
    },
    "physical": {"type": "object", "additionalProperties": false, "required": ["interface_kind", "interface_name", "media_type", "namespace_key", "node_type", "operator_role", "semantic_id", "semantic_id_algorithm"], "properties": {"interface_kind": {"enum": ["https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/cellular", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/ethernet", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/ieee80211", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/infiniband"]}, "interface_name": {"$ref": "#/$defs/encodedValue"}, "media_type": {"enum": ["ethernet", "ieee80211", "cellular", "infiniband"]}, "namespace_key": {"type": "string", "minLength": 1}, "node_type": {"const": "https://tbom.yozi.systems/registries/edge-network/node-types/1/physical"}, "operator_role": {"type": ["string", "null"]}, "semantic_id": {"$ref": "#/$defs/digest"}, "semantic_id_algorithm": {"const": "https://tbom.yozi.systems/algorithms/edge-network-topology/4.0.0/semantic-id-yozi-tid-v1-sha256"}}},
    "bridge": {"type": "object", "additionalProperties": false, "required": ["bridge_technology", "interface_kind", "interface_name", "namespace_key", "node_type", "parameters", "semantic_id", "semantic_id_algorithm"], "properties": {"bridge_technology": {"const": "ieee8021-bridge"}, "interface_kind": {"const": "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/linux-bridge"}, "interface_name": {"$ref": "#/$defs/encodedValue"}, "namespace_key": {"type": "string", "minLength": 1}, "node_type": {"const": "https://tbom.yozi.systems/registries/edge-network/node-types/1/bridge"}, "parameters": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/bridgeParameter"}}, "semantic_id": {"$ref": "#/$defs/digest"}, "semantic_id_algorithm": {"const": "https://tbom.yozi.systems/algorithms/edge-network-topology/4.0.0/semantic-id-yozi-tid-v1-sha256"}}},
    "vlan": {"type": "object", "additionalProperties": false, "required": ["interface_kind", "interface_name", "namespace_key", "node_type", "parent_semantic_id", "semantic_id", "semantic_id_algorithm", "vlan_id", "vlan_protocol"], "properties": {"interface_kind": {"const": "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/ieee8021q-vlan"}, "interface_name": {"$ref": "#/$defs/encodedValue"}, "namespace_key": {"type": "string", "minLength": 1}, "node_type": {"const": "https://tbom.yozi.systems/registries/edge-network/node-types/1/vlan"}, "parent_semantic_id": {"$ref": "#/$defs/digest"}, "semantic_id": {"$ref": "#/$defs/digest"}, "semantic_id_algorithm": {"const": "https://tbom.yozi.systems/algorithms/edge-network-topology/4.0.0/semantic-id-yozi-tid-v1-sha256"}, "vlan_id": {"type": "integer", "minimum": 0, "maximum": 4094}, "vlan_protocol": {"enum": [33024, 34984]}}},
    "tunnel": {"type": "object", "additionalProperties": false, "required": ["interface_kind", "interface_name", "local_endpoint", "namespace_key", "node_type", "parameters", "parent_semantic_ids", "remote_endpoint", "semantic_id", "semantic_id_algorithm"], "properties": {"interface_kind": {"$ref": "#/$defs/uri"}, "interface_name": {"$ref": "#/$defs/encodedValue"}, "local_endpoint": {"anyOf": [{"$ref": "#/$defs/endpoint"}, {"type": "null"}]}, "namespace_key": {"type": "string", "minLength": 1}, "node_type": {"const": "https://tbom.yozi.systems/registries/edge-network/node-types/1/tunnel"}, "parameters": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/tunnelParameter"}}, "parent_semantic_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "remote_endpoint": {"anyOf": [{"$ref": "#/$defs/endpoint"}, {"type": "null"}]}, "semantic_id": {"$ref": "#/$defs/digest"}, "semantic_id_algorithm": {"const": "https://tbom.yozi.systems/algorithms/edge-network-topology/4.0.0/semantic-id-yozi-tid-v1-sha256"}}},
    "logical": {"type": "object", "additionalProperties": false, "required": ["interface_kind", "interface_name", "namespace_key", "node_type", "parameters", "parent_semantic_ids", "semantic_id", "semantic_id_algorithm"], "properties": {"interface_kind": {"$ref": "#/$defs/uri"}, "interface_name": {"$ref": "#/$defs/encodedValue"}, "namespace_key": {"type": "string", "minLength": 1}, "node_type": {"const": "https://tbom.yozi.systems/registries/edge-network/node-types/1/logical"}, "parameters": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/logicalParameter"}}, "parent_semantic_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "semantic_id": {"$ref": "#/$defs/digest"}, "semantic_id_algorithm": {"const": "https://tbom.yozi.systems/algorithms/edge-network-topology/4.0.0/semantic-id-yozi-tid-v1-sha256"}}},
    "federationPeer": {"type": "object", "additionalProperties": false, "required": ["endpoints", "federation_mechanism", "interface_name", "namespace_key", "node_type", "operator_peer_key", "parameters", "public_key_identifier", "semantic_id", "semantic_id_algorithm", "trust_domain"], "properties": {"endpoints": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/endpoint"}}, "federation_mechanism": {"type": "string", "pattern": "^https://tbom\\.yozi\\.systems/registries/edge-network/federation-mechanisms/1/"}, "interface_name": {"type": "null"}, "namespace_key": {"type": "string", "minLength": 1}, "node_type": {"const": "https://tbom.yozi.systems/registries/edge-network/node-types/1/declared-federation-peer"}, "operator_peer_key": {"type": "string", "minLength": 1}, "parameters": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/federationParameter"}}, "public_key_identifier": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "semantic_id": {"$ref": "#/$defs/digest"}, "semantic_id_algorithm": {"const": "https://tbom.yozi.systems/algorithms/edge-network-topology/4.0.0/semantic-id-yozi-tid-v1-sha256"}, "trust_domain": {"$ref": "#/$defs/foreignHttpsUri"}}},
    "registeredTunnel": {"allOf": [{"$ref": "#/$defs/tunnel"}, {"properties": {"interface_kind": {"enum": ["https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/tun", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/tap", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/wireguard", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/gre", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/gre6", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/sit", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/ip6tnl", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/vxlan", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/geneve", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/l2tp"]}}}]},
    "registeredLogical": {"allOf": [{"$ref": "#/$defs/logical"}, {"properties": {"interface_kind": {"enum": ["https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/loopback", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/veth", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/bond", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/team", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/macvlan", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/ipvlan", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/vrf", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/dsa-port", "https://tbom.yozi.systems/registries/edge-network/interface-kinds/1/dummy"]}}}]},
    "node": {"oneOf": [{"$ref": "#/$defs/physical"}, {"$ref": "#/$defs/bridge"}, {"$ref": "#/$defs/vlan"}, {"$ref": "#/$defs/registeredTunnel"}, {"$ref": "#/$defs/registeredLogical"}, {"$ref": "#/$defs/federationPeer"}]},
    "relation": {"type": "object", "additionalProperties": false, "required": ["parameters", "relation_type", "source", "target"], "properties": {"parameters": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relationParameter"}}, "relation_type": {"type": "string", "pattern": "^https://tbom\\.yozi\\.systems/registries/edge-network/relation-types/1/"}, "source": {"$ref": "#/$defs/digest"}, "target": {"$ref": "#/$defs/digest"}}}
  }
}
